++++ awk -v shell=48237 $'\n  {\n    pid[NR] = $1; ppid[NR] = $2\n    line = $0\n    sub(/^[ \\t]*[0-9]+[ \\t]+[0-9]+[ \\t]+/, "", line)\n    comm[NR] = line\n  }\n  END {\n    want[shell] = 1\n    changed = 1\n    while (changed) {\n      changed = 0\n      for (n = 1; n <= NR; n++) {\n        if ((ppid[n] in want) && !(pid[n] in want)) { want[pid[n]] = 1; changed = 1 }\n      }\n    }\n    for (n = 1; n <= NR; n++) {\n      if ((pid[n] in want) && pid[n] != shell) printf "%s\\t%s\\n", pid[n], comm[n]\n    }\n  }'
